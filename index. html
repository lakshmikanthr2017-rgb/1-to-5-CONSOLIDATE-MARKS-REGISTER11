<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>1 to 5th Consolidated Marks Register</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header class="app-header">
        <div class="header-titles">
            <h1>GOVERNMENT LOWER/HIGHER PRIMARY SCHOOL</h1>
            <h2>1 TO 5TH CONSOLIDATED MARKS REGISTER - 2026-27</h2>
        </div>
        <div class="action-toolbar">
            <button id="addStudentBtn" class="btn btn-primary">+ Add Student</button>
            <button id="printBtn" class="btn btn-secondary">🖨️ Print A3 Landscape</button>
        </div>
    </header>

    <main class="table-container">
        <table id="marksRegisterTable">
            <thead>
                <tr>
                    <th rowspan="2">S NO</th>
                    <th rowspan="2">STUDENT NAME</th>
                    <th rowspan="2">DAYS PRESENT</th>
                    <th rowspan="2">TOTAL DAYS</th>
                    <th rowspan="2">SEMESTER</th>
                    <th rowspan="2">EXAMS</th>
                    <th rowspan="2">WEIGHT</th>
                    <th colspan="2">KANNADA</th>
                    <th colspan="2">ENGLISH</th>
                    <th colspan="2">MATHS</th>
                    <th colspan="2">EVS</th>
                    <th rowspan="2">TOTAL MARKS</th>
                    <th rowspan="2">PERCENTAGE</th>
                    <th rowspan="2">OVERALL GRADE</th>
                    <th colspan="5">CO-CURRICULAR ACTIVITIES GRADE</th>
                    <th rowspan="2">RESULT</th>
                </tr>
                <tr>
                    <th>MARKS</th><th>GRADE</th>
                    <th>MARKS</th><th>GRADE</th>
                    <th>MARKS</th><th>GRADE</th>
                    <th>MARKS</th><th>GRADE</th>
                    <th>PHYSICAL HEALTH</th>
                    <th>ARTS & CRAFTS</th>
                    <th>DANCE & MUSIC</th>
                    <th>SUPW</th>
                    <th>VALUE ED.</th>
                </tr>
            </thead>
            <tbody id="studentTableBody">
                <!-- Dynamic Student Blocks Render Here -->
            </tbody>
        </table>
    </main>

    <footer class="app-footer">
        <p class="designer-credit">Designed by : LAKSHMIKANTH R (Mob:9844444871)</p>
    </footer>

    <script src="script.js"></script>
</body>
</html>
